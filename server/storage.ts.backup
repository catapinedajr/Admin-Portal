import { 
  users, 
  dailyFacts, 
  lessons, 
  userProgress, 
  knowledgeAreas,
  convictionContent,
  treasuryCompanies,
  sovereignAdoption,
  deepDiveTopics,
  weeklyTopics,
  userWeeklyProgress,
  type User, 
  type InsertUser, 
  type DailyFact, 
  type InsertDailyFact,
  type Lesson,
  type InsertLesson,
  type UserProgress,
  type InsertUserProgress,
  type KnowledgeArea,
  type InsertKnowledgeArea,
  type ConvictionContent,
  type InsertConvictionContent,
  type TreasuryCompany,
  type InsertTreasuryCompany,
  type SovereignAdoption,
  type InsertSovereignAdoption,
  type BitcoinPrice,
  type InsertBitcoinPrice,
  type QuizQuestion,
  type InsertQuizQuestion,
  type UserQuizAnswer,
  type InsertUserQuizAnswer,
  type DeepDiveTopic,
  type InsertDeepDiveTopic,
  type WeeklyTopic,
  type InsertWeeklyTopic,
  type UserWeeklyProgress,
  type InsertUserWeeklyProgress
} from "@shared/schema";

export interface IStorage {
  // User methods
  getUser(id: number): Promise<User | undefined>;
  getUserByUsername(username: string): Promise<User | undefined>;
  createUser(user: InsertUser): Promise<User>;
  updateUserStreak(userId: number, currentStreak: number, longestStreak: number): Promise<void>;
  updateUserProgress(userId: number, completedLessons: number, lastActivityDate: string): Promise<void>;

  // Daily facts methods
  getDailyFacts(dayIndex: number): Promise<DailyFact[]>;
  getAllDailyFacts(): Promise<DailyFact[]>;
  createDailyFact(fact: InsertDailyFact): Promise<DailyFact>;

  // Lessons methods
  getLesson(dayIndex: number): Promise<Lesson | undefined>;
  getAllLessons(): Promise<Lesson[]>;
  createLesson(lesson: InsertLesson): Promise<Lesson>;

  // User progress methods
  getUserProgress(userId: number, date: string): Promise<UserProgress | undefined>;
  getUserProgressForWeek(userId: number, startDate: string): Promise<UserProgress[]>;
  createOrUpdateUserProgress(progress: InsertUserProgress): Promise<UserProgress>;

  // Knowledge areas methods
  getKnowledgeAreas(): Promise<KnowledgeArea[]>;
  updateKnowledgeAreaProgress(areaId: number, completedLessons: number): Promise<void>;

  // Conviction content methods
  getConvictionContent(dayIndex: number): Promise<ConvictionContent[]>;
  getAllConvictionContent(): Promise<ConvictionContent[]>;
  createConvictionContent(content: InsertConvictionContent): Promise<ConvictionContent>;

  // Treasury companies methods
  getTreasuryCompanies(): Promise<TreasuryCompany[]>;
  getTreasuryCompanyById(id: number): Promise<TreasuryCompany | undefined>;
  createTreasuryCompany(company: InsertTreasuryCompany): Promise<TreasuryCompany>;
  updateTreasuryCompany(id: number, updates: Partial<InsertTreasuryCompany>): Promise<TreasuryCompany | undefined>;

  // Sovereign adoption methods
  getSovereignAdoptions(): Promise<SovereignAdoption[]>;
  getSovereignAdoptionById(id: number): Promise<SovereignAdoption | undefined>;
  getSovereignAdoptionsByType(adoptionType: string): Promise<SovereignAdoption[]>;
  createSovereignAdoption(adoption: InsertSovereignAdoption): Promise<SovereignAdoption>;
  updateSovereignAdoption(id: number, updates: Partial<InsertSovereignAdoption>): Promise<SovereignAdoption | undefined>;

  // Bitcoin price methods
  getCurrentBitcoinPrice(): Promise<BitcoinPrice | undefined>;
  getBitcoinPriceHistory(hours: number): Promise<BitcoinPrice[]>;
  createBitcoinPrice(price: InsertBitcoinPrice): Promise<BitcoinPrice>;

  // Quiz methods
  getDailyQuizQuestions(dayIndex: number): Promise<QuizQuestion[]>;
  getAllQuizQuestions(): Promise<QuizQuestion[]>;
  createQuizQuestion(question: InsertQuizQuestion): Promise<QuizQuestion>;
  getUserQuizAnswers(userId: number, date: string): Promise<UserQuizAnswer[]>;
  submitQuizAnswer(answer: InsertUserQuizAnswer): Promise<UserQuizAnswer>;
  getUserQuizScore(userId: number, date: string): Promise<{ correct: number; total: number; percentage: number }>;

  // Deep dive topics methods
  getDailyDeepDive(dayIndex: number): Promise<DeepDiveTopic | undefined>;
  getAllDeepDiveTopics(): Promise<DeepDiveTopic[]>;
  createDeepDiveTopic(topic: InsertDeepDiveTopic): Promise<DeepDiveTopic>;

  // Weekly topics methods
  getCurrentWeeklyTopic(): Promise<WeeklyTopic | undefined>;
  getWeeklyTopic(weekNumber: number): Promise<WeeklyTopic | undefined>;
  getAllWeeklyTopics(): Promise<WeeklyTopic[]>;
  createWeeklyTopic(topic: InsertWeeklyTopic): Promise<WeeklyTopic>;
  
  // User weekly progress methods
  getUserWeeklyProgress(userId: number, weekNumber: number): Promise<UserWeeklyProgress | undefined>;
  createOrUpdateWeeklyProgress(progress: InsertUserWeeklyProgress): Promise<UserWeeklyProgress>;
  updateWeeklyProgress(userId: number, weekNumber: number, currentSection: number, progressPercentage: number): Promise<void>;
  completeWeeklyTopic(userId: number, weekNumber: number): Promise<void>;
}

export class MemStorage implements IStorage {
  private users: Map<number, User>;
  private dailyFacts: Map<number, DailyFact>;
  private lessons: Map<number, Lesson>;
  private userProgress: Map<string, UserProgress>; // key: userId-date
  private knowledgeAreas: Map<number, KnowledgeArea>;
  private convictionContent: Map<number, ConvictionContent>;
  private treasuryCompanies: Map<number, TreasuryCompany>;
  private sovereignAdoptions: Map<number, SovereignAdoption>;
  private bitcoinPrices: Map<number, BitcoinPrice>;
  private quizQuestions: Map<number, QuizQuestion>;
  private userQuizAnswers: Map<string, UserQuizAnswer>; // key: userId-questionId-date
  private deepDiveTopics: Map<number, DeepDiveTopic>;
  private weeklyTopics: Map<number, WeeklyTopic>;
  private userWeeklyProgress: Map<string, UserWeeklyProgress>; // key: userId-weekNumber
  private currentUserId: number;
  private currentFactId: number;
  private currentLessonId: number;
  private currentProgressId: number;
  private currentKnowledgeAreaId: number;
  private currentConvictionContentId: number;
  private currentTreasuryCompanyId: number;
  private currentSovereignAdoptionId: number;
  private currentBitcoinPriceId: number;
  private currentQuizQuestionId: number;
  private currentQuizAnswerId: number;
  private currentDeepDiveTopicId: number;
  private currentWeeklyTopicId: number;
  private currentWeeklyProgressId: number;

  constructor() {
    this.users = new Map();
    this.dailyFacts = new Map();
    this.lessons = new Map();
    this.userProgress = new Map();
    this.knowledgeAreas = new Map();
    this.convictionContent = new Map();
    this.treasuryCompanies = new Map();
    this.sovereignAdoptions = new Map();
    this.quizQuestions = new Map();
    this.userQuizAnswers = new Map();
    this.deepDiveTopics = new Map();
    this.weeklyTopics = new Map();
    this.userWeeklyProgress = new Map();
    this.currentUserId = 1;
    this.currentFactId = 1;
    this.currentLessonId = 1;
    this.currentProgressId = 1;
    this.currentKnowledgeAreaId = 1;
    this.currentConvictionContentId = 1;
    this.currentTreasuryCompanyId = 1;
    this.currentSovereignAdoptionId = 1;
    this.bitcoinPrices = new Map();
    this.currentBitcoinPriceId = 1;
    this.currentQuizQuestionId = 1;
    this.currentQuizAnswerId = 1;
    this.currentDeepDiveTopicId = 1;
    this.currentWeeklyTopicId = 1;
    this.currentWeeklyProgressId = 1;

    this.seedData();
  }

  private seedData() {
    // Week 1: "What Is Money Really?" - Building foundational understanding
    const facts = [
      // Day 1: What is Money?
      {
        title: "What Is Money?",
        content: "Money is anything that people agree has value and can be used to trade for goods and services.",
        category: "Money Basics",
        icon: "coins",
        dayIndex: 1
      },
      {
        title: "Medium of Exchange",
        content: "Money allows us to trade without bartering. Instead of trading chickens for shoes, we use money as an in-between step.",
        category: "Money Functions",
        icon: "refresh-cw",
        dayIndex: 1
      },
      {
        title: "Store of Value", 
        content: "Good money keeps its value over time. You should be able to save money today and buy similar things with it years later.",
        category: "Money Functions",
        icon: "piggy-bank",
        dayIndex: 1
      },



      // Day 4: Problems with Traditional Money
      {
        title: "Inflation",
        content: "When governments print more money, each dollar becomes worth less. This is why things cost more over time - your money loses value.",
        category: "Money Problems",
        icon: "trending-down",
        dayIndex: 4
      },
      {
        title: "Central Control",
        content: "Traditional money is controlled by governments and banks. They can print more, freeze accounts, or stop transactions at will.",
        category: "Money Problems",
        icon: "building-2",
        dayIndex: 4
      },

      // Week 1: Unit of Account
      {
        title: "Unit of Account",
        content: "Money provides a common way to measure and compare the value of different things. Instead of saying '1 cow = 10 chickens = 100 apples,' we can say everything in dollar terms.",
        category: "Money Functions",
        icon: "calculator",
        dayIndex: 2
      },

      // Week 1: Trust and Social Agreement  
      {
        title: "Trust & Agreement",
        content: "All money systems depend on community trust. Whether it's gold, paper bills, or digital numbers, money only works when people believe others will accept it.",
        category: "Money Basics",
        icon: "handshake",
        dayIndex: 3
      }
    ];

    facts.forEach(fact => {
      const newFact: DailyFact = { ...fact, id: this.currentFactId++ };
      this.dailyFacts.set(newFact.id, newFact);
    });

    // Week 1: What Is Money Really? - Complete lesson set
    const lessons = [
      {
        title: "What Is Money Really? - Day 1",
        content: `Imagine you're living thousands of years ago, and you've just grown the most beautiful apples anyone has ever seen. Your neighbor has crafted the warmest, most comfortable shoes in the village. You want those shoes, but your neighbor doesn't want apples - they need grain for bread. What do you do?

This simple problem has puzzled humans throughout history and led to one of humanity's greatest inventions: money. Money isn't just pieces of paper or metal coins - it's a solution to the fundamental challenge of how people can trade and cooperate with each other.

At its core, money is anything that people in a community agree has value and can be used to exchange for goods and services. It's a shared belief system that makes complex societies possible. Without money, every trade would require the perfect coincidence of wants - you'd need to find someone who has what you want and wants what you have, at the exact same time.

Money serves three essential functions that make our modern world possible. First, it acts as a medium of exchange, allowing us to break the complex chain of bartering into simple transactions. Instead of trading apples for grain for shoes, you can sell your apples for money, then use that money to buy shoes directly. Second, money serves as a store of value, letting you save your hard work today to benefit from it tomorrow. Finally, money works as a unit of account, giving us a consistent way to measure and compare the value of different things.

The story of money is really the story of human cooperation and trust. Every form of money, from seashells to gold to paper bills, works because a community of people agrees to believe in its value. This shared belief creates the foundation for trade, savings, investment, and the complex economic systems that power our world.

Understanding what money really is helps us appreciate why the invention of Bitcoin represents such a revolutionary moment in human history - it's not just a new type of money, but a completely new way of creating trust and cooperation without needing to rely on any central authority.`,
        summary: "Money solves the fundamental problem of trade by serving as a medium of exchange, store of value, and unit of account based on shared community agreement.",
        estimatedReadTime: 8,
        dayIndex: 0
      },

      {
        title: "The History of Money - Day 2", 
        content: `Money wasn't invented overnight. It evolved through thousands of years of human innovation, with each stage solving the limitations of what came before.

The story begins with barter systems, where people traded goods directly with each other. A farmer might trade wheat for pottery, or a hunter might exchange meat for tools. While this worked for simple societies, it had serious limitations. You needed to find someone who wanted exactly what you had AND had exactly what you wanted, at the exact same moment. This "coincidence of wants" problem made complex trade nearly impossible.

The first breakthrough came when communities started using commodity money - everyday items that everyone valued. Cattle became money in some societies because everyone understood their worth. Salt was so valuable as money that Roman soldiers were sometimes paid in salt, giving us the word "salary." Grain worked well because it was divisible and everyone needed food. These commodity monies worked because they had intrinsic value - they were useful even if nobody accepted them as payment.

The next evolution was towards more practical commodity money like precious metals. Gold and silver became popular across many cultures because they shared ideal properties: they were scarce enough to hold value, durable enough to last years, portable enough to carry, and divisible into smaller pieces. Most importantly, they were universally recognized as valuable across different cultures and regions.

Paper money represented another revolutionary leap. Instead of carrying heavy gold coins, people could carry lightweight paper certificates that represented gold stored safely elsewhere. This worked beautifully as long as people trusted that the paper could always be exchanged for actual gold. Banks and governments issued these certificates, promising to honor them with real precious metals.

The final stage in traditional money's evolution came in 1971 when the connection between paper money and gold was permanently severed. This created "fiat" money - currency backed only by government promise rather than tangible assets. While this gave governments more flexibility, it also introduced new problems like inflation and central control that Bitcoin was designed to solve.

Understanding this progression helps us see why Bitcoin represents such a significant breakthrough - it combines the best features of each previous stage while eliminating their biggest weaknesses.`,
        summary: "Money evolved from barter to commodity money to precious metals to paper certificates to modern fiat currency, with each stage solving previous limitations while creating new challenges.",
        estimatedReadTime: 8,
        dayIndex: 1
      },

      {
        title: "The Problems with Modern Money - Day 3",
        content: `Today's money system has three fundamental problems that affect everyone, whether they realize it or not. Understanding these problems helps explain why many people are looking for alternatives like Bitcoin.

The first problem is inflation, which is essentially a hidden tax on everyone who holds money. When governments create new money faster than the economy grows, each existing dollar becomes less valuable. This isn't accidental - it's designed into the system. Since 1971, the US dollar has lost over 85% of its purchasing power. That means if your grandparents saved $100 in 1971, it would only buy about $15 worth of goods today. Your savings slowly lose value just by existing, forcing everyone to constantly seek investments just to maintain their purchasing power.

The second problem is centralized control. A small group of people in government and central banks have enormous power over everyone's money. They can print trillions of new dollars during crises, freeze bank accounts, reverse transactions, and control who can participate in the financial system. This power has grown significantly, with financial deplatforming becoming a new form of political control. Your money isn't truly yours if someone else can prevent you from accessing or using it.

The third problem is exclusion. Over 2 billion people worldwide don't have access to basic banking services. They can't open accounts, receive international payments, or participate in the global economy - not because they lack value to offer, but because they live in the wrong place or don't meet institutional requirements. Even people with bank accounts face restrictions on international transfers, high fees, and slow settlement times.

These problems aren't bugs in the system - they're features. The current monetary system concentrates power and extracts value from users to benefit institutions. Every transaction fee, every point of inflation, every barrier to access serves someone's interests, but not necessarily yours.

This is why Bitcoin was created. It addresses each of these problems directly: it has a fixed supply that can't be inflated away, operates without central control, and provides equal access to anyone with internet connection. Bitcoin represents a return to money that serves users rather than institutions.`,
        summary: "Modern money suffers from inflation by design, centralized control by institutions, and systematic exclusion of billions of people from the global financial system.",
        estimatedReadTime: 8,
        dayIndex: 2
      },

      {
        title: "What Makes Good Money? - Day 4",
        content: `Throughout history, the best forms of money have shared certain characteristics. Understanding these properties helps us evaluate any form of money, from ancient seashells to modern cryptocurrencies.

**Scarcity** is perhaps the most important property. Money must be limited in quantity to hold value over time. If anyone could create unlimited amounts of money, it would quickly become worthless. Gold became popular partly because it's naturally scarce - there's only so much gold in the earth's crust. When money loses scarcity, like when governments print too much paper currency, inflation destroys its value as a store of wealth.

**Durability** ensures money can survive over time. Wheat might have value, but it rots quickly, making it poor long-term money. Gold doesn't rust, decay, or break down, which helped it serve as money for thousands of years. Your money needs to maintain its physical form long enough to be useful for future transactions.

**Portability** allows money to be easily transported and exchanged. Massive stone wheels were used as money on some Pacific islands, but they were terrible for everyday commerce because they were so difficult to move. Paper money solved gold's portability problem - it's much easier to carry paper certificates than heavy gold coins.

**Divisibility** enables precise transactions of any size. You need to be able to make change and pay exact amounts. Gold could be divided into smaller pieces, though this required special tools and expertise. Modern money is highly divisible - you can pay for something costing $12.47 with exact change.

**Fungibility** means each unit is interchangeable with every other unit. One gold coin of the same weight and purity should be worth exactly the same as another identical coin. This property makes accounting and trading much simpler, since you don't need to evaluate each individual piece of money separately.

**Recognizability** allows people to easily identify and verify authentic money. Throughout history, communities developed ways to recognize their money and distinguish it from counterfeits. This might involve specific designs, physical properties, or verification methods that everyone understands.

The best money optimizes all these properties simultaneously. Each form of money throughout history made trade-offs between these characteristics. Understanding these properties helps us evaluate new forms of money and understand why some succeed while others fail.`,
        summary: "Good money exhibits six key properties: scarcity, durability, portability, divisibility, fungibility, and recognizability - each essential for effective monetary function.",
        estimatedReadTime: 8,
        dayIndex: 3
      },

      {
        title: "Trust and Cooperation in Money - Day 5",
        content: `Money is fundamentally a technology for human cooperation. It's not just about economics - it's about how people can work together and trust each other, even when they're strangers.

Think about what happens when you accept money in exchange for something valuable. You're making a bet that other people will also accept that same money in the future. This requires remarkable coordination across an entire community. Everyone must believe that everyone else believes in the money's value. This shared belief system is what economists call "social consensus," and it's more fragile than it appears.

Traditional money systems build trust through institutions. Banks promise to honor deposits, governments promise to accept their currency for tax payments, and legal systems promise to enforce contracts. These institutions reduce the risk of accepting money by providing guarantees and recourse when things go wrong. If someone pays you with a bad check, you can pursue legal remedies. If a bank fails, government insurance might protect your deposits.

But institutional trust comes with costs and limitations. Institutions can fail, become corrupt, or change the rules. They can exclude people arbitrarily, charge high fees, and exercise power over users. Most importantly, they create single points of failure - when key institutions fail, entire monetary systems can collapse. The 2008 financial crisis showed how institutional failures can ripple through the entire global economy.

Bitcoin represents a different approach to monetary trust. Instead of relying on institutions, it uses mathematics and economic incentives to create trust. The rules are enforced by thousands of computers running identical software, making it virtually impossible for any single party to change the rules or cheat the system. This is called "trustless" money, though it's more accurate to say it's "trust-minimized" - you still need to trust in mathematics and economic rationality, but you don't need to trust any specific person or institution.

This shift from institutional trust to mathematical trust has profound implications. It means money can exist without government approval, operate across borders without intermediaries, and include anyone with internet access. It also means users must take more personal responsibility - there's no customer service number to call if you lose your private keys.

The evolution from institutional trust to mathematical trust represents one of the most significant changes in monetary systems since the invention of paper money. It's creating new possibilities for human cooperation that were impossible before.`,
        summary: "Money requires social trust and cooperation. Traditional systems use institutions to build trust, while Bitcoin uses mathematics and incentives to minimize trust requirements.",
        estimatedReadTime: 8,
        dayIndex: 4
      },

      {
        title: "Money and Power - Day 6",
        content: `Control over money is control over people. Throughout history, whoever controls the money system wields enormous power over society. Understanding this relationship helps explain many political and economic developments throughout history.

When kings and emperors controlled money, they could fund armies, build monuments, and reward loyalty by creating new coins. They could also debase the currency - mixing cheaper metals with gold and silver - to fund their activities while secretly taxing everyone who held their money. Citizens had little choice but to accept whatever currency their ruler provided, since alternative forms of money were often banned or impractical.

Modern central banking represents the evolution of this power. Central banks can create trillions of dollars with keystrokes, influencing interest rates, employment levels, and asset prices across the entire economy. This power is supposed to be used responsibly for public benefit, but it inevitably creates winners and losers. Those closest to the money creation process - large banks, financial institutions, and governments - benefit first from new money, while ordinary citizens experience the effects later through higher prices.

The ability to exclude people from the financial system has become a new form of political power. Banks can close accounts, payment processors can refuse service, and governments can impose sanctions that cut entire countries off from international banking. This financial deplatforming can be more effective than traditional forms of punishment because modern life is impossible without access to the financial system.

Money printing redistributes wealth from savers to borrowers, from the poor to the wealthy, and from the future to the present. When central banks create new money, they're not creating new wealth - they're redistributing existing wealth to whoever receives the new money first. This process is often invisible to those affected, making it a politically convenient way to transfer resources.

Bitcoin challenges this power structure by removing the ability to arbitrarily create new money or exclude participants. No central authority can print more Bitcoin, and no institution can prevent someone from making a Bitcoin transaction. This represents a fundamental shift in monetary power from institutions back to individuals.

This power shift explains much of the resistance to Bitcoin from established institutions. It's not just about technology or economics - it's about who gets to control the most important tool for human cooperation and value exchange. Bitcoin offers a path toward monetary systems that serve users rather than rulers.`,
        summary: "Control over money systems equals political power. Bitcoin redistributes monetary power from central institutions back to individual users through fixed supply and permissionless access.",
        estimatedReadTime: 8,
        dayIndex: 5
      },

      {
        title: "Digital Money Before Bitcoin - Day 7",
        content: `Bitcoin wasn't the first attempt to create digital money. For decades, computer scientists, cryptographers, and entrepreneurs tried to solve the challenge of creating money that exists purely as digital information. Understanding these earlier attempts helps us appreciate Bitcoin's breakthrough innovations.

The fundamental problem with digital money is the "double spending" problem. Unlike physical money, digital information can be copied perfectly and infinitely. If digital money is just data, what prevents someone from copying that data and spending the same digital coins multiple times? This problem seemed insurmountable for decades.

Early digital money systems solved double spending through central authorities. Companies like DigiCash in the 1990s created electronic cash systems where a central server tracked all coins and prevented double spending. These systems offered privacy and convenience but failed commercially because they still required trust in a central authority, making them vulnerable to government pressure and business failure.

Other attempts focused on using existing banking infrastructure. Systems like PayPal and digital gift cards essentially moved traditional money electronically rather than creating new forms of money. While convenient, these systems inherited all the limitations of traditional banking: central control, geographic restrictions, and dependence on existing financial institutions.

The cypherpunk movement of the 1980s and 1990s recognized that true digital money would need to be decentralized to avoid the problems of central control. Cryptographers like David Chaum, Nick Szabo, and Hal Finney developed many of the cryptographic techniques that would later become essential to Bitcoin. They envisioned money that could exist purely as information, protected by mathematics rather than institutions.

The missing piece was solving double spending without a central authority. This required a way for a distributed network of computers to agree on the order of transactions without trusting each other. Computer scientists called this the "Byzantine Generals Problem" - how can distributed parties reach consensus when some might be malicious or unreliable?

Bitcoin's breakthrough was combining several existing technologies in a novel way: cryptographic hash functions, digital signatures, proof of work, and economic incentives. This created the first system where digital money could exist without central control while preventing double spending through network consensus.

Bitcoin succeeded where others failed because it aligned individual incentives with network security. Participants are rewarded for honest behavior and punished for attempting to cheat, creating a self-sustaining system that grows stronger as it becomes more valuable.`,
        summary: "Previous digital money attempts failed due to the double spending problem and central points of failure. Bitcoin solved these issues through decentralized consensus and economic incentives.",
        estimatedReadTime: 8,
        dayIndex: 6
      }
    ];

    // Create lesson instances
    lessons.forEach(lesson => {
      const newLesson: Lesson = { ...lesson, id: this.currentLessonId++ };
      this.lessons.set(newLesson.id, newLesson);
    });

    // Knowledge areas for Week 1: What Is Money Really?
    const knowledgeAreas = [
      {
        id: 1,
        title: "Money Fundamentals",
        description: "Understanding the basic concept and functions of money",
        completedLessons: 3,
        totalLessons: 7,
        category: "Foundation"
      },
      {
        id: 2, 
        title: "Historical Evolution",
        description: "How money has evolved from barter to modern systems",
        completedLessons: 2,
        totalLessons: 7,
        category: "History"
      },
      {
        id: 3,
        title: "Modern Problems",
        description: "Issues with current fiat currency systems",
        completedLessons: 1,
        totalLessons: 7,
        category: "Analysis"
      }
    ];

    // Create knowledge area instances
    knowledgeAreas.forEach(area => {
      const newArea: KnowledgeArea = { ...area, id: this.currentKnowledgeAreaId++ };
      this.knowledgeAreas.set(newArea.id, newArea);
    });

Beyond matching gold's traditional monetary properties, Bitcoin offers revolutionary advantages that were impossible in the physical world. Bitcoin is fully programmable, meaning it can be sent automatically based on predetermined conditions without human intervention. It operates completely permissionlessly, eliminating the need for expensive vaults, guards, and trusted intermediaries. All Bitcoin transactions are transparent and publicly verifiable on the blockchain, creating unprecedented monetary accountability. Perhaps most importantly, properly stored Bitcoin cannot be confiscated by any authority since only the private key holder can move it.

The network effect amplifies these advantages as adoption grows. When more people recognize Bitcoin's superior monetary properties, demand increases while supply remains mathematically fixed, creating upward price pressure over long time horizons. Each new participant makes the network more valuable and secure, creating a self-reinforcing cycle of improvement.

Bitcoin represents the ultimate evolution of money - combining the proven scarcity of gold with the revolutionary utility of digital technology, creating superior hard money perfectly designed for the internet age.`,
        summary: "Bitcoin serves as digital gold, combining scarcity with superior portability, divisibility, and verifiability compared to traditional stores of value.",
        estimatedReadTime: 8,
        dayIndex: 5
      },

      {
        title: "The Lightning Network: Bitcoin's Second Layer",
        content: `Imagine Bitcoin as a sophisticated banking system with two distinct purposes, each perfectly designed for its role. The base layer serves as the ultimate settlement system - like the massive vaults and clearinghouses that handle the world's most important financial transactions. While this base layer prioritizes absolute security and decentralization, it processes transactions deliberately slowly, handling about seven transactions per second globally. This isn't a limitation; it's an intentional design choice that prioritizes security over speed.

But what happens when you want to buy coffee with Bitcoin? Waiting 10 minutes for confirmation doesn't work for daily commerce. This is where Lightning Network enters the story as Bitcoin's brilliant second layer solution, designed specifically for fast, cheap transactions that make Bitcoin practical for everyday payments.

The Lightning Network works through an elegant system of payment channels that feels almost magical in its simplicity. Picture two people who frequently exchange money - perhaps a customer and their favorite coffee shop. Instead of broadcasting every small transaction to the entire Bitcoin network, they can open a payment channel by locking some Bitcoin in a special shared account that requires both parties to agree before moving funds. Once this channel exists, they can send payments back and forth instantly, as many times as they want, without fees or delays. When they're finished, they simply close the channel and the final balances get settled on Bitcoin's main blockchain.

The real magic happens when these individual payment channels connect to form a vast network. Suddenly, you don't need a direct channel with everyone you want to pay. Instead, payments can route through interconnected channels, like sending a message through a network of friends. If Alice has a channel with Bob, and Bob has a channel with Carol, then Alice can pay Carol by routing the payment through Bob. This creates a web of instant transactions that spans the globe.

The benefits are transformative for Bitcoin's usability. Lightning payments confirm in milliseconds rather than minutes, often cost less than a penny regardless of amount, provide enhanced privacy since individual payments aren't recorded on the public blockchain, and can theoretically handle millions of transactions per second. This scaling breakthrough suddenly makes Bitcoin practical for applications that were previously impossible.

Today, Lightning is already powering real-world commerce across diverse applications. Content creators receive micropayments and tips online, merchants accept instant point-of-sale payments, people send cross-border remittances without traditional banking delays, and gamers purchase digital content with tiny payments that would be impractical on the base layer.

This layered approach mirrors the internet's architecture, where different layers handle different functions optimally. Bitcoin's base layer serves as the secure settlement foundation, Lightning provides the fast payment experience, and future layers will add additional functionality. Together, they enable Bitcoin to serve both as a store of value through its secure base layer and as a practical medium of exchange through Lightning's instant transactions, finally delivering on Bitcoin's promise of being both digital gold and everyday money.`,
        summary: "The Lightning Network is Bitcoin's second layer solution, enabling instant, low-cost payments while maintaining the security of Bitcoin's base layer.",
        estimatedReadTime: 9,
        dayIndex: 6
      }
    ];

    lessons.forEach((lessonData, index) => {
      const lesson: Lesson = {
        id: this.currentLessonId++,
        title: lessonData.title,
        content: lessonData.content,
        summary: lessonData.summary,
        estimatedReadTime: lessonData.estimatedReadTime,
        dayIndex: lessonData.dayIndex,
        imageUrl: null
      };
      this.lessons.set(lesson.id, lesson);
